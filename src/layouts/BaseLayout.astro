---
import '../styles/base.css';
import { t, htmlLang, ogLocale, locales, localeNames, defaultLocale, type Locale } from '../i18n';
import { contact } from '../data/contact';
import { sidebarIcons } from '../data/icons';
import type { TocItem } from '../lib/toc';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Suppress hreflang alternates for pages that exist in one locale only. */
  noAlternate?: boolean;
  /** 文章详情页：侧栏顶部换成目录，联系方式与「更多」让位给正文导航。 */
  outline?: TocItem[];
  /** 侧栏里固定的返回链接（吸顶，不随正文滚走）。 */
  back?: { href: string; label: string };
}

const {
  title,
  description,
  locale = defaultLocale,
  noAlternate = false,
  outline = [],
  back,
} = Astro.props;

const canonicalUrl = `https://soulcreator.cn${Astro.url.pathname}`;
const ogImage = 'https://soulcreator.cn/og-image.png';
const pageDesc = description ?? t(locale, 'meta.home.desc');

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const currentIsLocale = pathSegments.length > 0 && (locales as string[]).includes(pathSegments[0]);
const baseSegments = currentIsLocale ? pathSegments.slice(1) : pathSegments;
const swapLocale = (target: string) => '/' + [target, ...baseSegments].join('/');

// 当前所在区块，用于导航的 aria-current 态
const section = baseSegments[0] ?? '';
const navCurrent = (key: string) => (section === key ? 'page' : undefined);

const otherLocales = locales.filter((l) => l !== locale);
const githubUrl = 'https://github.com/mnigc';
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A0A0A" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="SoulCreator" href="https://soulcreator.cn/rss.xml" />
    {!noAlternate && locales.map((l) => (
      <link rel="alternate" hreflang={l} href={`https://soulcreator.cn${swapLocale(l)}/`} />
    ))}
    {!noAlternate && (
      <link rel="alternate" hreflang="x-default" href={`https://soulcreator.cn${swapLocale(defaultLocale)}/`} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var mode = 'auto';
        try { mode = localStorage.getItem('theme') || 'auto'; } catch (e) {}
        var mql = window.matchMedia('(prefers-color-scheme: dark)');
        var dark = mode === 'dark' || (mode === 'auto' && mql.matches);
        var el = document.documentElement;
        el.dataset.theme = dark ? 'dark' : 'light';
        el.dataset.themeMode = mode;
      })();
    </script>
  </head>
  <body>
    <!-- 玻璃药丸的折射滤镜:置换贴图让背景在药丸边缘发生弯折,模拟 Liquid Glass。
         仅被 backdrop-filter: url() 支持的浏览器(Chromium)使用,其余忽略。 -->
    <svg class="glass-defs" aria-hidden="true" focusable="false">
      <defs>
        <filter id="glass-lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feImage
            href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20100%20100'%20preserveAspectRatio='none'%3E%3Crect%20width='100'%20height='100'%20fill='rgb(128,128,128)'/%3E%3ClinearGradient%20id='a'%20x1='0'%20y1='0'%20x2='1'%20y2='0'%3E%3Cstop%20offset='0'%20stop-color='rgb(82,128,128)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(128,128,128)'/%3E%3C/linearGradient%3E%3ClinearGradient%20id='b'%20x1='0'%20y1='0'%20x2='1'%20y2='0'%3E%3Cstop%20offset='0'%20stop-color='rgb(128,128,128)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(174,128,128)'/%3E%3C/linearGradient%3E%3ClinearGradient%20id='c'%20x1='0'%20y1='0'%20x2='0'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='rgb(128,82,128)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(128,128,128)'/%3E%3C/linearGradient%3E%3ClinearGradient%20id='d'%20x1='0'%20y1='0'%20x2='0'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='rgb(128,128,128)'/%3E%3Cstop%20offset='1'%20stop-color='rgb(128,174,128)'/%3E%3C/linearGradient%3E%3Crect%20x='0'%20y='22'%20width='32'%20height='56'%20fill='url(%23a)'/%3E%3Crect%20x='68'%20y='22'%20width='32'%20height='56'%20fill='url(%23b)'/%3E%3Crect%20x='0'%20y='0'%20width='100'%20height='30'%20fill='url(%23c)'/%3E%3Crect%20x='0'%20y='70'%20width='100'%20height='30'%20fill='url(%23d)'/%3E%3C/svg%3E"
            x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map" />
          <feDisplacementMap in="SourceGraphic" in2="map" scale="40" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>
    <a class="skip-link" href="#content">{t(locale, 'nav.skip')}</a>

    <div class="shell">
      <header class="masthead">
        <a class="identity" href={`/${locale}/`}>
          <!-- 内联 SVG:颜色走 CSS 变量,logo 可随主题切换;无底板,仅胶片唱片本体,
               圆心小孔用页面底色近似透出。favicon.svg 仍作为浏览器标签页图标 -->
          <svg class="avatar" viewBox="0 0 32 32" width="40" height="40" aria-hidden="true">
            <circle cx="16" cy="16" r="6" style="fill: var(--logo-disc)" />
            <circle cx="16" cy="16" r="10" style="fill: none; stroke: var(--logo-disc)" stroke-width="0.8" opacity="0.4" />
            <circle cx="16" cy="16" r="14" style="fill: none; stroke: var(--logo-ring)" stroke-width="0.5" opacity="0.2" />
            <circle cx="16" cy="16" r="2" style="fill: var(--bg)" />
          </svg>
          <span class="identity-text">
            <strong>SoulCreator</strong>
            <span class="identity-sub">@mnigc</span>
          </span>
        </a>
        <nav class="site-nav" aria-label={t(locale, 'nav.label')}>
          <a href={`/${locale}/tools/`} aria-current={navCurrent('tools')}>{t(locale, 'nav.tools')}</a>
          <a href={`/${locale}/writing/`} aria-current={navCurrent('writing')}>{t(locale, 'nav.writing')}</a>
          <a href={`/${locale}/about/`} aria-current={navCurrent('about')}>{t(locale, 'nav.about')}</a>
          <a class="nav-external" href={githubUrl} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
          {otherLocales.map((l) => (
            <a class="lang-link" href={swapLocale(l) + '/'} hreflang={l}>{localeNames[l]}</a>
          ))}
          <button
            class="theme-toggle"
            type="button"
            aria-label={t(locale, 'theme.auto')}
            title={t(locale, 'theme.auto')}
            data-label-auto={t(locale, 'theme.auto')}
            data-label-light={t(locale, 'theme.light')}
            data-label-dark={t(locale, 'theme.dark')}
          >
            <svg class="icon-auto" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="12" r="9" fill="currentColor" opacity="0.32" />
              <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" />
            </svg>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" />
              <path d="M12 1.8v3M12 19.2v3M1.8 12h3M19.2 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M19.4 4.6l-2.1 2.1M6.7 17.3l-2.1 2.1" />
            </svg>
          </button>
        </nav>
      </header>

      <div class:list={['columns', { 'columns-post': !!back }]}>
        <main id="content">
          <slot />
        </main>

        <aside class="sidebar">
          {back && (
            <p class="breadcrumb">
              <a href={back.href}><span class="arr" aria-hidden="true">←</span> {back.label}</a>
            </p>
          )}
          {outline.length > 0 ? (
            <nav class="toc" aria-label={t(locale, 'side.outline')}>
              <h2 class="side-title">{t(locale, 'side.outline')}</h2>
              <ul>
                {outline.map((item) => (
                  <li class={item.depth > 2 ? 'd3' : undefined}>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ) : (
            <section>
              <h2 class="side-title">{t(locale, 'side.contact')}</h2>
              <ul>
                <li>
                  <span class="s-ic" aria-hidden="true"><svg width="15" height="15" viewBox={sidebarIcons.email.viewBox} fill="currentColor" set:html={sidebarIcons.email.body} /></span>
                  <div class="s-txt"><a href={`mailto:${contact.email}`}>{contact.email}</a></div>
                </li>
                <li>
                  <span class="s-ic" aria-hidden="true"><svg width="15" height="15" viewBox={sidebarIcons.wechat.viewBox} fill="currentColor" set:html={sidebarIcons.wechat.body} /></span>
                  <div class="s-txt">
                    {t(locale, 'side.wechat')} {contact.wechat}
                    {contact.wechatQr && (
                      <details class="qr">
                        <summary>{t(locale, 'side.qr')}</summary>
                        <img src={contact.wechatQr} width="140" height="140" alt={t(locale, 'side.wechat') + ' QR'} loading="lazy" />
                      </details>
                    )}
                  </div>
                </li>
                <li>
                  <span class="s-ic" aria-hidden="true"><svg width="15" height="15" viewBox={sidebarIcons.instagram.viewBox} fill="currentColor" set:html={sidebarIcons.instagram.body} /></span>
                  <div class="s-txt"><a href={`https://www.instagram.com/${contact.instagramHandle}/`} target="_blank" rel="noopener">Instagram @{contact.instagramHandle}</a></div>
                </li>
              </ul>
            </section>
          )}
          {!back && (
          <section>
            <h2 class="side-title">{t(locale, 'side.more')}</h2>
            <ul>
              <li>
                <span class="s-ic" aria-hidden="true"><svg width="15" height="15" viewBox={sidebarIcons.github.viewBox} fill="currentColor" set:html={sidebarIcons.github.body} /></span>
                <div class="s-txt"><a href={githubUrl} target="_blank" rel="noopener">GitHub @mnigc</a></div>
              </li>
              <li>
                <span class="s-ic" aria-hidden="true"><svg width="15" height="15" viewBox={sidebarIcons.code.viewBox} fill="currentColor" set:html={sidebarIcons.code.body} /></span>
                <div class="s-txt"><a href="https://github.com/mnigc/soulcreator" target="_blank" rel="noopener">{t(locale, 'side.source')}</a></div>
              </li>
              <li>
                <span class="s-ic" aria-hidden="true"><svg width="15" height="15" viewBox={sidebarIcons.rss.viewBox} fill="currentColor" set:html={sidebarIcons.rss.body} /></span>
                <div class="s-txt"><a href="/rss.xml">RSS</a></div>
              </li>
            </ul>
          </section>
          )}
        </aside>
      </div>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} SoulCreator</p>
        <nav class="footer-nav" aria-label={t(locale, 'nav.label')}>
          <a href={`/${locale}/tools/`}>{t(locale, 'nav.tools')}</a>
          <a href={`/${locale}/writing/`}>{t(locale, 'nav.writing')}</a>
          <a href={githubUrl} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
          <a href="/rss.xml">RSS</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </nav>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var el = document.documentElement;
        var btn = document.querySelector('.theme-toggle');
        var order = ['auto', 'light', 'dark'];
        var labels = btn
          ? { auto: btn.dataset.labelAuto, light: btn.dataset.labelLight, dark: btn.dataset.labelDark }
          : {};
        function getMode() {
          try { return localStorage.getItem('theme') || 'auto'; } catch (e) { return 'auto'; }
        }
        function apply(mode) {
          var dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          el.dataset.theme = dark ? 'dark' : 'light';
          el.dataset.themeMode = mode;
          try { localStorage.setItem('theme', mode); } catch (e) {}
          if (labels[mode]) {
            btn.title = labels[mode];
            btn.setAttribute('aria-label', labels[mode]);
          }
        }
        if (btn) {
          apply(getMode());
          btn.addEventListener('click', function () {
            apply(order[(order.indexOf(getMode()) + 1) % order.length]);
          });
        }
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          if (getMode() === 'auto') el.dataset.theme = e.matches ? 'dark' : 'light';
        });
      })();
    </script>
  </body>
</html>
