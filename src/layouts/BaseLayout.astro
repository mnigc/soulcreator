---
import '../styles/base.css';
import { t, htmlLang, ogLocale, locales, localeNames, defaultLocale, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, description, locale = defaultLocale } = Astro.props;

const now = new Date();
const canonicalUrl = `https://soulcreator.cn${Astro.url.pathname}`;
const ogImage = 'https://soulcreator.cn/og-image.png';
const pageDesc = description ?? t(locale, 'meta.desc');

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const currentIsLocale = pathSegments.length > 0 && (locales as string[]).includes(pathSegments[0]);
const baseSegments = currentIsLocale ? pathSegments.slice(1) : pathSegments;
const swapLocale = (target: string) => '/' + [target, ...baseSegments].join('/');

const navLinks = [
  { href: `/${locale}/tools`, key: 'nav.tools' },
  { href: `/${locale}/about`, key: 'nav.about' },
];
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A0A0A" />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={`https://soulcreator.cn${swapLocale(l)}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://soulcreator.cn${swapLocale(defaultLocale)}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var mode = localStorage.getItem('theme-mode');
        if (!mode) mode = 'auto';
        var isDark = false;
        if (mode === 'dark') {
          isDark = true;
        } else if (mode === 'light') {
          isDark = false;
        } else {
          isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        document.documentElement.style.backgroundColor = isDark ? '#0E0E0E' : '#F9F9F7';
      })();
    </script>
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-inner">
        <a href={`/${locale}`} class="navbar-brand">
          <span class="brand-mark"></span>
          SoulCreator
        </a>
        <button class="menu-toggle" aria-label={t(locale, 'menu.aria')} aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
        <ul class="nav-links">
          {navLinks.map(link => (
            <li>
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
                {t(locale, link.key)}
              </a>
            </li>
          ))}
          <li class="theme-switch" aria-label={t(locale, 'theme.auto')}>
            <button data-theme="light" class="theme-btn" title={t(locale, 'theme.light')}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
              </svg>
            </button>
            <button data-theme="dark" class="theme-btn" title={t(locale, 'theme.dark')}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </button>
            <button data-theme="auto" class="theme-btn" title={t(locale, 'theme.auto')}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="12" rx="2"/>
                <path d="M7 20h10M10 16v4M14 16v4"/>
                <path d="M7 8h6"/>
              </svg>
            </button>
          </li>
          <li class="lang-switch">
            <div class="lang-current" tabindex="0" aria-label="Language">
              {localeNames[locale]}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <ul class="lang-menu">
              {locales.map(l => (
                <li>
                  <a href={swapLocale(l)} hreflang={l} aria-current={l === locale ? 'true' : undefined}>
                    {localeNames[l]}
                  </a>
                </li>
              ))}
            </ul>
          </li>
          <li><a href="https://github.com/mnigc" class="nav-cta" target="_blank" rel="noopener">{t(locale, 'nav.github')} ↗</a></li>
        </ul>
      </div>
    </nav>

<main id="content">
  <slot />
</main>

<footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="brand-mark"></span>
          SoulCreator
        </div>
        <ul class="footer-links">
          <li><a href={`/${locale}/tools`}>{t(locale, 'nav.tools')}</a></li>
          <li><a href={`/${locale}/about`}>{t(locale, 'nav.about')}</a></li>
          <li><a href="https://github.com/mnigc" target="_blank" rel="noopener">{t(locale, 'nav.github')}</a></li>
        </ul>
        <p class="footer-colophon">
          <span class="footer-visits">
            {t(locale, 'footer.visits')}: <span class="footer-visits-num" data-visits>—</span>
          </span>
          &middot; &copy; {now.getFullYear()}
        </p>
      </div>
    </footer>

    <script>
      (function () {
        var STORAGE_KEY = 'theme-mode';

        function getSystemDark() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        function resolveTheme(mode) {
          if (mode === 'light') return 'light';
          if (mode === 'dark') return 'dark';
          return getSystemDark() ? 'dark' : 'light';
        }

        function setTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }

        function getSaved() {
          return localStorage.getItem(STORAGE_KEY) || 'auto';
        }

        function updateUI() {
          var mode = getSaved();
          var theme = resolveTheme(mode);
          setTheme(theme);
          document.querySelectorAll('.theme-btn').forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-theme') === mode);
          });
        }

        document.querySelectorAll('.theme-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var mode = btn.getAttribute('data-theme');
            localStorage.setItem(STORAGE_KEY, mode);
            updateUI();
          });
        });

        var menuToggle = document.querySelector('.menu-toggle');
        var navLinks = document.querySelector('.nav-links');
        if (menuToggle && navLinks) {
          menuToggle.addEventListener('click', function () {
            var expanded = menuToggle.getAttribute('aria-expanded') === 'true';
            menuToggle.setAttribute('aria-expanded', String(!expanded));
            navLinks.classList.toggle('open');
            if (navLinks.classList.contains('open')) {
              var firstLink = navLinks.querySelector('a, button');
              if (firstLink) firstLink.focus();
            } else {
              menuToggle.focus();
            }
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && navLinks.classList.contains('open')) {
              navLinks.classList.remove('open');
              menuToggle.setAttribute('aria-expanded', 'false');
              menuToggle.focus();
            }
          });
          navLinks.addEventListener('keydown', function (e) {
            if (e.key === 'Tab' && navLinks.classList.contains('open')) {
              var focusable = navLinks.querySelectorAll('a[href], button:not([disabled])');
              if (focusable.length === 0) return;
              var first = focusable[0];
              var last = focusable[focusable.length - 1];
              if (e.shiftKey) {
                if (document.activeElement === first) {
                  e.preventDefault();
                  last.focus();
                }
              } else {
                if (document.activeElement === last) {
                  e.preventDefault();
                  first.focus();
                }
              }
            }
          });
        }

        var langCurrent = document.querySelector('.lang-current');
        if (langCurrent) {
          langCurrent.addEventListener('click', function (e) {
            e.stopPropagation();
            var sw = langCurrent.closest('.lang-switch');
            if (sw) sw.classList.toggle('open');
          });
          langCurrent.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              var sw = langCurrent.closest('.lang-switch');
              if (sw) sw.classList.toggle('open');
            }
          });
        }

        document.addEventListener('click', function () {
          var sw = document.querySelector('.lang-switch');
          if (sw) sw.classList.remove('open');
        });

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('.faq-q');
          if (btn) {
            var item = btn.closest('.faq-item');
            var open = item.classList.toggle('open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          }
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if (getSaved() === 'auto') {
            updateUI();
          }
        });

         updateUI();
       })();

       /* ─── Hero Particles ─── */
       (function () {
         var canvas = document.querySelector('.hero-particles');
         if (!canvas) return;
         var ctx = canvas.getContext('2d');
         var particles = [];
         var animId = null;

         function getThemeColor() {
           var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
           return isDark ? { dot: '245,245,245', line: '245,245,245', dotAlpha: 0.45, lineAlpha: 0.1 } : { dot: '26,26,26', line: '26,26,26', dotAlpha: 0.35, lineAlpha: 0.08 };
         }

         function resize() {
           canvas.width = canvas.offsetWidth * (window.devicePixelRatio || 1);
           canvas.height = canvas.offsetHeight * (window.devicePixelRatio || 1);
           ctx.scale(window.devicePixelRatio || 1, window.devicePixelRatio || 1);
         }

         function init() {
           resize();
           particles = [];
           var count = Math.floor((canvas.offsetWidth * canvas.offsetHeight) / 12000);
           count = Math.min(Math.max(count, 30), 100);
           for (var i = 0; i < count; i++) {
             particles.push({
               x: Math.random() * canvas.offsetWidth,
               y: Math.random() * canvas.offsetHeight,
               vx: (Math.random() - 0.5) * 0.25,
               vy: (Math.random() - 0.5) * 0.25,
               r: Math.random() * 1.4 + 0.4
             });
           }
         }

         var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

         function draw() {
           var w = canvas.offsetWidth;
           var h = canvas.offsetHeight;
           var color = getThemeColor();
           ctx.clearRect(0, 0, w, h);

           for (var i = 0; i < particles.length; i++) {
             var p = particles[i];
             p.x += p.vx;
             p.y += p.vy;
             if (p.x < 0 || p.x > w) p.vx *= -1;
             if (p.y < 0 || p.y > h) p.vy *= -1;

             ctx.beginPath();
             ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
             ctx.fillStyle = 'rgba(' + color.dot + ',' + color.dotAlpha + ')';
             ctx.fill();

             for (var j = i + 1; j < particles.length; j++) {
               var q = particles[j];
               var dx = q.x - p.x;
               var dy = q.y - p.y;
               var dist = Math.sqrt(dx * dx + dy * dy);
               if (dist < 110) {
                 ctx.beginPath();
                 ctx.moveTo(p.x, p.y);
                 ctx.lineTo(q.x, q.y);
                 ctx.strokeStyle = 'rgba(' + color.line + ',' + (color.lineAlpha * (1 - dist / 110)) + ')';
                 ctx.lineWidth = 0.6;
                 ctx.stroke();
               }
             }
           }
           if (!reduceMotion) {
             animId = requestAnimationFrame(draw);
           }
         }

         init();
         draw();

          var resizeTimer;
          window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
              init();
              if (reduceMotion) draw();
            }, 200);
          });

         var observer = new MutationObserver(function () {
           // Theme changed, colors will update on next frame
         });
         observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
       })();

       /* ─── Hero 3D Parallax ─── */
       (function () {
         var visual = document.querySelector('.hero-visual');
         var d3 = document.querySelector('.hero-3d');
         if (!visual || !d3) return;

         var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
         if (reduceMotion) {
           d3.style.animation = 'none';
           return;
         }

         var targetX = 0, targetY = 0;
         var currentX = 0, currentY = 0;
         var baseRX = -18, baseRY = 28;
         var rafId = null;

         function onMove(e) {
           var rect = visual.getBoundingClientRect();
           var cx = rect.left + rect.width / 2;
           var cy = rect.top + rect.height / 2;
           var dx = (e.clientX - cx) / (rect.width / 2);
           var dy = (e.clientY - cy) / (rect.height / 2);
           targetX = Math.max(-1, Math.min(1, dx));
           targetY = Math.max(-1, Math.min(1, dy));
         }

         function tick() {
           currentX += (targetX - currentX) * 0.08;
           currentY += (targetY - currentY) * 0.08;
           var px = currentX * 14;
           var py = currentY * 12;
           d3.style.setProperty('--parallax-x', px + 'deg');
           d3.style.setProperty('--parallax-y', py + 'deg');
           rafId = requestAnimationFrame(tick);
         }

         function start() {
           if (rafId) return;
           tick();
         }
         function stop() {
           if (rafId) {
             cancelAnimationFrame(rafId);
             rafId = null;
           }
         }

          window.addEventListener('mousemove', onMove, { passive: true });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) start(); else stop();
            });
          });
          io.observe(visual);

          window.addEventListener('mouseleave', function () {
            targetX = 0; targetY = 0;
          });
        })();

        /* ─── Visit counter ─── */
        (function () {
          var el = document.querySelector('[data-visits]');
          if (!el) return;

          function format(n) {
            return n.toLocaleString('en-US');
          }

          function read() {
            fetch('/api/visits', { credentials: 'omit', cache: 'no-store' })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (d) { if (d && typeof d.total === 'number') el.textContent = format(d.total); })
              .catch(function () {});
          }

          function ping() {
            var key = 'sc-visit-' + new Date().toISOString().slice(0, 10);
            try {
              if (sessionStorage.getItem(key)) { read(); return; }
              sessionStorage.setItem(key, '1');
            } catch (e) { /* ignore */ }
            fetch('/api/visit', { method: 'POST', credentials: 'omit', keepalive: true })
              .then(read)
              .catch(function () {});
          }

          if ('requestIdleCallback' in window) {
            requestIdleCallback(ping, { timeout: 1500 });
          } else {
            setTimeout(ping, 800);
          }
        })();
      </script>
   </body>
</html>
