---
import '../styles/base.css';

const { title, description = 'SoulCreator — 独立开发者的效率工具集合', lang = 'zh-CN' } = Astro.props;

const now = new Date();
const edition = now.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '/');

const tickerItems = [
  { text: '04 已发布工具', badge: '' },
  { text: '∞ 免费使用', badge: 'FREE' },
  { text: 'MIT 开源协议', badge: 'OSS' },
  { text: '01 独立开发者', badge: '' },
  { text: '本地优先 · 隐私安全', badge: 'PRIVATE' },
  { text: '持续迭代 · 零追踪', badge: '' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <header class="masthead">
      <div class="masthead-inner">
        <a href="/" class="brand">
          <span class="brand-mark"></span>
          SoulCreator
        </a>
        <div class="edition">
          <span>Vol. 1</span>
          <span>{edition}</span>
          <span>独立开发者版</span>
        </div>
      </div>
    </header>

    <nav class="navbar">
      <div class="navbar-inner">
        <a href="/" class="navbar-brand">
          <span class="brand-mark"></span>
          SoulCreator
        </a>
        <ul class="nav-links">
          <li><a href="/tools">工具</a></li>
          <li><a href="/about">关于</a></li>
          <li><a href="https://github.com/mnigc#readme" target="_blank" rel="noopener">文档</a></li>
          <li><a href="https://github.com/mnigc" class="nav-cta" target="_blank" rel="noopener">GitHub ↗</a></li>
        </ul>
      </div>
    </nav>

    <main id="content">
      <slot />
    </main>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {tickerItems.map(item => (
          <span>
            <i class="dot"></i>
            {item.text}
            {item.badge && <span class="badge">▲ {item.badge}</span>}
          </span>
        ))}
        {tickerItems.map(item => (
          <span>
            <i class="dot"></i>
            {item.text}
            {item.badge && <span class="badge">▲ {item.badge}</span>}
          </span>
        ))}
      </div>
    </div>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="brand-mark"></span>
          SoulCreator
        </div>
        <ul class="footer-links">
          <li><a href="/tools">工具</a></li>
          <li><a href="/about">关于</a></li>
          <li><a href="https://github.com/mnigc" target="_blank" rel="noopener">GitHub</a></li>
        </ul>
        <p class="footer-colophon">
          Edition: Vol. 1.0 &middot; Made by a human &middot; &copy; {now.getFullYear()}
        </p>
      </div>
    </footer>
  </body>
</html>