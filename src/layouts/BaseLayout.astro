---
import '../styles/base.css';

const { title, description = 'SoulCreator — 独立开发者的效率工具集合', lang = 'zh-CN' } = Astro.props;

const now = new Date();

const tickerItems = [
  { text: '04 已发布工具', badge: '' },
  { text: '∞ 免费使用', badge: 'FREE' },
  { text: 'MIT 开源协议', badge: 'OSS' },
  { text: '01 独立开发者', badge: '' },
  { text: '本地优先 · 隐私安全', badge: 'PRIVATE' },
  { text: '持续迭代 · 零追踪', badge: '' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var mode = localStorage.getItem('theme-mode');
        if (!mode) mode = 'auto';
        var isDark = false;
        if (mode === 'dark') {
          isDark = true;
        } else if (mode === 'light') {
          isDark = false;
        } else {
          isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        document.documentElement.style.backgroundColor = isDark ? '#0E0E0E' : '#F9F9F7';
      })();
    </script>
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-inner">
        <a href="/" class="navbar-brand">
          <span class="brand-mark"></span>
          SoulCreator
        </a>
        <button class="menu-toggle" aria-label="菜单" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
        <ul class="nav-links">
          <li><a href="/tools">工具</a></li>
          <li><a href="/about">关于</a></li>
          <li><a href="https://github.com/mnigc#readme" target="_blank" rel="noopener">文档</a></li>
          <li class="theme-switch" aria-label="主题切换">
            <button data-theme="light" class="theme-btn" title="浅色模式">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
              </svg>
            </button>
            <button data-theme="dark" class="theme-btn" title="深色模式">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </button>
            <button data-theme="auto" class="theme-btn" title="跟随系统">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="12" rx="2"/>
                <path d="M7 20h10M10 16v4M14 16v4"/>
                <path d="M7 8h6"/>
              </svg>
            </button>
          </li>
          <li><a href="https://github.com/mnigc" class="nav-cta" target="_blank" rel="noopener">GitHub ↗</a></li>
        </ul>
      </div>
    </nav>

    <main id="content">
      <slot />
    </main>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {tickerItems.map(item => (
          <span>
            <i class="dot"></i>
            {item.text}
            {item.badge && <span class="badge">▲ {item.badge}</span>}
          </span>
        ))}
        {tickerItems.map(item => (
          <span>
            <i class="dot"></i>
            {item.text}
            {item.badge && <span class="badge">▲ {item.badge}</span>}
          </span>
        ))}
      </div>
    </div>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="brand-mark"></span>
          SoulCreator
        </div>
        <ul class="footer-links">
          <li><a href="/tools">工具</a></li>
          <li><a href="/about">关于</a></li>
          <li><a href="https://github.com/mnigc" target="_blank" rel="noopener">GitHub</a></li>
        </ul>
        <p class="footer-colophon">
          Edition: Vol. 1.0 &middot; Made by a human &middot; &copy; {now.getFullYear()}
        </p>
      </div>
    </footer>

    <script>
      (function () {
        var STORAGE_KEY = 'theme-mode';

        function getSystemDark() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        function resolveTheme(mode) {
          if (mode === 'light') return 'light';
          if (mode === 'dark') return 'dark';
          return getSystemDark() ? 'dark' : 'light';
        }

        function setTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
        }

        function getSaved() {
          return localStorage.getItem(STORAGE_KEY) || 'auto';
        }

        function updateUI() {
          var mode = getSaved();
          var theme = resolveTheme(mode);
          setTheme(theme);
          document.querySelectorAll('.theme-btn').forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-theme') === mode);
          });
        }

        document.querySelectorAll('.theme-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var mode = btn.getAttribute('data-theme');
            localStorage.setItem(STORAGE_KEY, mode);
            updateUI();
          });
        });

        var menuToggle = document.querySelector('.menu-toggle');
        if (menuToggle) {
          menuToggle.addEventListener('click', function () {
            var expanded = menuToggle.getAttribute('aria-expanded') === 'true';
            menuToggle.setAttribute('aria-expanded', String(!expanded));
            var links = document.querySelector('.nav-links');
            if (links) links.classList.toggle('open');
          });
        }

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if (getSaved() === 'auto') {
            updateUI();
          }
        });

        updateUI();
      })();
    </script>
  </body>
</html>