---
import { getCollection } from 'astro:content';
import Base from '../../layouts/BaseLayout.astro';
import ToolIcon from '../../components/ui/ToolIcon.astro';

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map(entry => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}

const { props } = Astro;
const tool = { ...props.data };

const iconMap: Record<string, string> = {
  currency: 'currency',
  medi: 'media',
  omni: 'markdown',
  clipboard: 'clipboard',
};
const slug = props.slug;
const icon = Object.keys(iconMap).find(k => slug.includes(k))
  ? iconMap[Object.keys(iconMap).find(k => slug.includes(k))!]
  : 'currency';
---

<script type="application/ld+json">
  {JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.title,
    description: tool.description,
    applicationCategory: tool.category,
    operatingSystem: tool.platform,
    offers: { '@type': 'Offer', price: '0' },
  })}
</script>

<Base title={`${tool.title} — SoulCreator`} description={tool.description}>

<section class="detail-hero page">
  <div class="detail-hero-grid">
    <div>
      <div class="detail-hero-head">
        <a href="/tools" class="detail-back" aria-label="返回工具列表">
          <ToolIcon name="arrow" size={14} />
          <span>全部工具</span>
        </a>
        <span class="detail-category">{tool.category}</span>
      </div>
      <span class="detail-badge">■ {tool.platform}</span>
      <h1 class="detail-title">{tool.title}</h1>
      <p class="detail-title-en">{tool.titleEn}</p>
      <p class="detail-sub">{tool.description}</p>
      <div class="detail-tags">
        {tool.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <div class="detail-cta">
        <a href="https://github.com/mnigc" class="btn btn-primary" target="_blank" rel="noopener">
          <ToolIcon name="github" size={14} />
          <span>GitHub ↗</span>
        </a>
        <a href="/tools" class="btn btn-outline">
          <ToolIcon name="arrow" size={14} />
          <span>查看全部工具</span>
        </a>
      </div>
    </div>
    <div class="detail-hero-icon">
      <div class="detail-icon-badge">
        <ToolIcon name={icon} size={48} />
      </div>
      <span class="detail-icon-label">Product</span>
    </div>
  </div>
</section>

{tool.stats && tool.stats.length > 0 && (
  <section class="section page" data-od-id="tool-stats">
    <div class="section-head">
      <span class="label">At a Glance</span>
      <h2>关键指标</h2>
      <p>几个数字，快速了解这款工具的能力。</p>
    </div>
    <div class="stats-grid">
      {tool.stats.map(item => (
        <div class="stats-cell">
          <span class="stats-label">{item.label}</span>
          <span class="stats-value">{item.value}</span>
          <span class="stats-sub">▲ {item.sub}</span>
        </div>
      ))}
    </div>
  </section>
)}

{tool.features && tool.features.length > 0 && (
  <section class="section page" data-od-id="tool-features">
    <div class="section-head">
      <span class="label">Features</span>
      <h2>核心能力</h2>
      <p>每一个功能都围绕一个真实的使用场景设计。</p>
    </div>
    <div class="feature-grid">
      {tool.features.map((feat, i) => (
        <div class="feature-card">
          <div class="feature-num">0{i + 1}</div>
          <h4 class="feature-title">{feat.title}</h4>
          <p class="feature-text">{feat.text}</p>
        </div>
      ))}
    </div>
  </section>
)}

{tool.faq && tool.faq.length > 0 && (
  <section class="section page" data-od-id="tool-faq">
    <div class="section-head" style="text-align: center;">
      <span class="label">FAQ</span>
      <h2>常见问题</h2>
      <p style="margin-inline: auto;">关于 {tool.title} 的一些常见问题。</p>
    </div>
    <div class="faq-grid">
      {tool.faq.map(item => (
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">
            <span>{item.q}</span>
            <span class="plus">+</span>
          </button>
          <div class="faq-a-wrap">
            <div class="faq-a">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
    <script>
      document.querySelectorAll('.faq-q').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.faq-item');
          var open = item.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
    </script>
  </section>
)}

<div class="ornament">✦ ✦ ✦</div>

<section class="section page" data-od-id="tool-back">
  <div style="text-align: center;">
    <span class="label">Next</span>
    <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); margin: 0.5rem 0;">发现更多工具</h2>
    <p style="color: var(--neutral-600); max-width: 480px; margin: 0.5rem auto 1.25rem; font-size: 0.9rem;">
      浏览 SoulCreator 的其他工具产品，找到下一个提升效率的助手。
    </p>
    <a href="/tools" class="btn btn-primary">
      <ToolIcon name="arrow" size={14} />
      <span>查看全部工具</span>
    </a>
  </div>
</section>

</Base>