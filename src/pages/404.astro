---
import Base from '../layouts/BaseLayout.astro';
import { t, locales, defaultLocale, type Locale } from '../i18n';

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const detected = pathSegments.length > 0 && (locales as string[]).includes(pathSegments[0]);
const locale = (detected ? pathSegments[0] : defaultLocale) as Locale;
---

<Base title={t(locale, 'notfound.title')} locale={locale}>
  <article class="prose notfound">
    <h1>404</h1>
    <p>{t(locale, 'notfound.desc')}</p>
    <p><a href={`/${locale}/`}>{t(locale, 'notfound.home')}</a></p>
  </article>
</Base>
