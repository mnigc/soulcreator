---
import Base from '../layouts/BaseLayout.astro';
---

<Base title="页面未找到 — SoulCreator">
  <section class="hero" data-od-id="404">
    <div class="hero-orb"></div>
    <span class="hero-badge">404</span>
    <h1 class="hero-title">
      这个<span class="gradient-text">工具</span><br/>
      还没造出来
    </h1>
    <p class="hero-subtitle">
      可能页面已经移动或正在开发中。<br/>
      试试浏览我们的工具列表，看看有没有你需要的。
    </p>
    <div class="hero-cta-group">
      <a href="/" class="btn btn-primary">返回首页</a>
      <a href="/tools" class="btn btn-ghost">浏览工具</a>
    </div>
  </section>
</Base>