---
import Base from '../layouts/BaseLayout.astro';
---

<Base title="页面未找到 — SoulCreator">
  <section class="hero-404">
    <div class="page" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
      <span class="hero-badge">■ 404</span>
      <h1>
        这个<span style="color: var(--accent);">工具</span><br/>
        还没造出来
      </h1>
      <p>
        可能页面已经移动或正在开发中。
        <br/>
        试试浏览我们的工具列表，看看有没有你需要的。
      </p>
      <div class="hero-cta" style="display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/" class="btn btn-primary">返回首页</a>
        <a href="/tools" class="btn btn-outline">浏览工具</a>
      </div>
    </div>
  </section>
</Base>