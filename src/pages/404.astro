---
import Base from '../layouts/BaseLayout.astro';
import { t, locales, defaultLocale, type Locale } from '../i18n';

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const detectedLocale = pathSegments.length > 0 && (locales as string[]).includes(pathSegments[0])
  ? pathSegments[0] as Locale
  : defaultLocale;

const locale = detectedLocale;
const pageTitle = `${t(locale, 'notfound.title1')}${t(locale, 'notfound.titleAccent')}${t(locale, 'notfound.title2')} — SoulCreator`;
const pageDesc = t(locale, 'notfound.desc');
---

<Base title={pageTitle} description={pageDesc} locale={locale}>
  <section class="hero-404">
    <div class="page" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
      <span class="hero-badge">{t(locale, 'notfound.badge')}</span>
      <h1>
        {t(locale, 'notfound.title1')}<span style="color: var(--accent);">{t(locale, 'notfound.titleAccent')}</span><br/>
        {t(locale, 'notfound.title2')}
      </h1>
      <p>
        {t(locale, 'notfound.desc')}
        <br/>
        {t(locale, 'notfound.desc2')}
      </p>
      <div class="hero-cta" style="display: flex; justify-content: center; flex-wrap: wrap; gap: 0.75rem;">
        <a href={`/${locale}`} class="btn btn-primary">{t(locale, 'notfound.home')}</a>
        <a href={`/${locale}/tools`} class="btn btn-outline">{t(locale, 'notfound.tools')}</a>
      </div>
    </div>
  </section>
</Base>
