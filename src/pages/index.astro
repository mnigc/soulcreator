---
import Base from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ToolCard from '../components/ui/ToolCard.astro';
import InstallPanel from '../components/ui/InstallPanel.astro';

const tools = await getCollection('tools');
const featuredTools = tools.slice(0, 4).map(t => ({ slug: t.slug, ...t.data }));

const compareRows = [
  { feature: '浏览器扩展', values: ['✓', '–', '–', '–'] },
  { feature: '桌面应用', values: ['–', '✓', '✓', '✓'] },
  { feature: '本地优先 · 隐私', values: ['✓', '✓', '✓', '✓'] },
  { feature: '完全免费', values: ['✓', '✓', '✓', '✓'] },
  { feature: '开源', values: ['✓', '✓', '✓', '✓'] },
  { feature: '批量处理', values: ['–', '✓', '✓', '✓'] },
];

const faqs = [
  { q: '这些工具收费吗？', a: '全部免费。没有付费墙，没有隐藏收费，所有功能都开放使用。' },
  { q: '代码开源吗？', a: '是的，核心代码以 MIT 协议开源，你可以在 GitHub 上 fork、修改、自托管。' },
  { q: '我的数据安全吗？', a: '桌面类工具均在本地完成处理，不上传任何文件到服务器；浏览器扩展也在页面内本地运算。' },
  { q: '支持哪些平台？', a: '浏览器扩展支持 Chrome / Edge；桌面应用支持 Windows / macOS / Linux；另外提供命令行入口。' },
];
---

<Base title="SoulCreator — 独立开发者的效率工具集合" description="SoulCreator 是一名独立开发者做的工具集合：网页货币转换、媒体格式转换与压缩、万物转 Markdown 等。免费、开源、本地优先。">

  <section class="hero">
    <div class="hero-grid">
      <div>
        <span class="hero-badge">■ 独立开发 · 每日更新</span>
        <h1 class="hero-title">
          我做的几个<br/><span class="accent">小工具</span>
        </h1>
        <p class="hero-lede">
          我是 SoulCreator，一名独立开发者。下面这些工具都来自我自己日常里的痛点——顺手做出来，免费、开源、能本地跑就本地跑。不追求"生态"，只解决真实的小问题。
        </p>
        <div class="hero-cta">
          <a href="/tools" class="btn btn-primary">
            浏览全部工具
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 10h10M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="https://github.com/mnigc" class="btn btn-outline" target="_blank" rel="noopener">
            GitHub ↗
          </a>
        </div>
        <InstallPanel />
        <p class="hero-note">Join thousands of teams already using SoulCreator</p>
      </div>

      <aside class="hero-aside">
        <div class="stats-panel">
          <div class="stats-panel-header">Market Watch</div>
          <div class="stats-panel-body">
            <div class="stat-item">
              <span class="stat-label">已发布工具</span>
              <span class="stat-value">
                <span class="stat-num">04</span>
                <span class="stat-sub">▲ Shipping</span>
              </span>
            </div>
            <div class="stat-item">
              <span class="stat-label">免费使用</span>
              <span class="stat-value">
                <span class="stat-num">∞</span>
                <span class="stat-sub">▲ Free forever</span>
              </span>
            </div>
            <div class="stat-item">
              <span class="stat-label">开源协议</span>
              <span class="stat-value">
                <span class="stat-num">MIT</span>
                <span class="stat-sub">▲ Fully OSS</span>
              </span>
            </div>
            <div class="stat-item">
              <span class="stat-label">独立开发者</span>
              <span class="stat-value">
                <span class="stat-num">01</span>
                <span class="stat-sub">▲ Solo</span>
              </span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section page" data-od-id="featured-tools">
    <div class="section-head">
      <span class="label">Tools</span>
      <h2>我做了些什么</h2>
      <p>每一个都为了解决一个具体的小问题，而不是为了"全家桶"。</p>
    </div>
    <div class="tool-grid">
      {featuredTools.map(tool => (
        <ToolCard {...tool} />
      ))}
    </div>
    <div style="margin-top: 2rem; text-align: center;">
      <a href="/tools" class="btn btn-ghost">
        查看全部工具
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 10h10M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </section>

  <section class="section page" data-od-id="compare">
    <div class="section-head">
      <span class="label">Compare</span>
      <h2>四个工具，各管一摊</h2>
      <p>没有"全能选手"，只有刚好够用的小工具。</p>
    </div>
    <div class="compare-wrap">
      <table class="compare-table">
        <thead>
          <tr>
            <th>能力</th>
            <th>网页货币转换</th>
            <th>媒体转换</th>
            <th>万物转 MD</th>
            <th>剪贴板</th>
          </tr>
        </thead>
        <tbody>
          {compareRows.map(row => (
            <tr>
              <th>{row.feature}</th>
              {row.values.map(v => (
                <td class={v === '✓' ? 'compare-yes' : 'compare-no'}>{v}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section page" data-od-id="faq">
    <div class="section-head" style="text-align: center;">
      <span class="label">FAQ</span>
      <h2>常见问题</h2>
      <p style="margin-inline: auto;">关于 SoulCreator 与这些工具的一些疑问。</p>
    </div>
    <div class="faq-list">
      {faqs.map(item => (
        <div class="faq-item">
          <button class="faq-q" aria-expanded="false">
            <span>{item.q}</span>
            <span class="plus">+</span>
          </button>
          <div class="faq-a-wrap">
            <div class="faq-a"><p>{item.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-q').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.faq-item');
        var open = item.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  </script>
</Base>