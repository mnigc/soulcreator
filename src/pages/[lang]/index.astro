---
import Base from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { t, getToolI18n, toolOrder, localeParams, type Locale } from '../../i18n';
import ToolCard from '../../components/ui/ToolCard.astro';
import FaqItem from '../../components/ui/FaqItem.astro';

export async function getStaticPaths() {
  return localeParams();
}

const locale = Astro.params.lang as Locale;

const tools = await getCollection('tools');
const localizedTools = tools.map((entry) => {
  const i18n = getToolI18n(entry.data, entry.slug, locale);
  return { slug: entry.slug, titleEn: entry.data.titleEn, ...entry.data, ...i18n };
});
const ordered = toolOrder
  .map((slug) => localizedTools.find((tool) => tool.slug === slug))
  .filter(Boolean);

const faqs = [1, 2, 3, 4].map((i) => ({
  q: t(locale, `faq${i}.q`),
  a: t(locale, `faq${i}.a`),
}));

const pageTitle = `${t(locale, 'hero.title1')} ${t(locale, 'hero.titleAccent')} — SoulCreator`;
const pageDesc = t(locale, 'hero.lede');
---

<Base title={pageTitle} description={pageDesc} locale={locale}>
   <section class="hero">
     <canvas class="hero-particles" aria-hidden="true"></canvas>
     <div class="hero-grid">
       <span class="hero-badge">{t(locale, 'hero.badge')}</span>
       <h1 class="hero-title">
         {t(locale, 'hero.title1')}<br /><span class="accent">{t(locale, 'hero.titleAccent')}</span>
       </h1>
       <p class="hero-lede">{t(locale, 'hero.lede')}</p>
       <div class="hero-cta">
         <a href={`/${locale}/tools`} class="btn btn-primary">
           {t(locale, 'hero.ctaBrowse')}
           <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
             <path d="M5 10h10M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
           </svg>
         </a>
         <a href="https://github.com/mnigc" class="btn btn-outline" target="_blank" rel="noopener">
           {t(locale, 'hero.ctaGithub')}
         </a>
       </div>
     </div>
     <div class="hero-scroll-hint" aria-hidden="true"></div>
   </section>

  <section class="section page" data-od-id="featured-tools">
    <div class="section-head">
      <span class="label">{t(locale, 'sec.tools.label')}</span>
      <h2>{t(locale, 'sec.tools.title')}</h2>
      <p>{t(locale, 'sec.tools.desc')}</p>
    </div>
    <div class="tool-grid">
      {ordered.map((tool) => <ToolCard {...tool} locale={locale} />)}
    </div>
  </section>

  <section class="section page" data-od-id="faq">
    <div class="section-head" style="text-align: center;">
      <span class="label">{t(locale, 'sec.faq.label')}</span>
      <h2>{t(locale, 'sec.faq.title')}</h2>
      <p style="margin-inline: auto;">{t(locale, 'sec.faq.desc')}</p>
    </div>
    <div class="faq-list">
      {faqs.map((item) => (
        <FaqItem q={item.q} a={item.a} />
      ))}
    </div>
  </section>
</Base>
