---
import Base from '../../layouts/BaseLayout.astro';
import { t, localeParams, type Locale } from '../../i18n';
import { getPosts, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  return localeParams();
}

const locale = Astro.params.lang as Locale;
const recentPosts = (await getPosts()).slice(0, 5);
---

<Base title={t(locale, 'meta.home.title')} description={t(locale, 'meta.home.desc')} locale={locale}>
  <article class="prose">
    <h1 set:html={t(locale, 'home.hello')} />
    <p class="lede">{t(locale, 'home.intro')}</p>
    <p class="callout">{t(locale, 'home.notice')}</p>

    <section class="home-section" id="writing">
      <h2>{t(locale, 'home.writing.title')}</h2>
      <ul class="post-list">
        {recentPosts.map((post) => (
          <li class="post-row">
            <a href={`/zh/writing/${post.id}/`}>{post.data.title}</a>
            <span class="leader" aria-hidden="true"></span>
            <time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
          </li>
        ))}
        <li class="post-row post-row-more">
          <a href={`/${locale}/writing/`}>{t(locale, 'home.writing.all')} <span class="arr" aria-hidden="true">→</span></a>
          <span class="leader" aria-hidden="true"></span>
        </li>
      </ul>
    </section>
  </article>
</Base>
