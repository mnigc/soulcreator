---
import Base from '../../layouts/BaseLayout.astro';
import { t, localeParams, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return localeParams();
}

const locale = Astro.params.lang as Locale;
---

<Base title={t(locale, 'meta.about.title')} description={t(locale, 'meta.about.desc')} locale={locale}>
  <article class="prose">
    <h1>{t(locale, 'about.h1')}</h1>
    <p class="lede">{t(locale, 'about.lede')}</p>
    <p>{t(locale, 'about.text1')}</p>
    <p>{t(locale, 'about.text2')}</p>
    <p>{t(locale, 'about.text3')}</p>
    <p>
      {t(locale, 'about.contact.text')}
      <a href="https://github.com/mnigc" target="_blank" rel="noopener">@mnigc</a>
    </p>
  </article>
</Base>
