---
import Base from '../../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { t, type Locale } from '../../../i18n';
import { getPosts, formatDate } from '../../../lib/content';
import { getToc } from '../../../lib/toc';

// Posts are written in Chinese; only zh pages are generated. The en writings
// list links here directly (see writing/index.astro).
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { lang: 'zh', slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const locale = Astro.params.lang as Locale;
const { Content } = await render(post);
// 侧栏顶部用大纲替换联系方式；没有小标题的文章保持原样
const toc = getToc(post.body ?? '');
---

<Base
  title={`${post.data.title} — SoulCreator`}
  description={post.data.description}
  locale={locale}
  noAlternate
  outline={toc}
  back={{ href: `/${locale}/writing/`, label: t(locale, 'writing.h1') }}
>
  <article class="prose">
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
    </p>
    {post.data.description && <p class="lede">{post.data.description}</p>}
    <div class="prose-md">
      <Content />
    </div>
  </article>
</Base>
