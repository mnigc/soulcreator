---
import Base from '../../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { t, locales, type Locale } from '../../../i18n';
import { getTools } from '../../../lib/content';

export async function getStaticPaths() {
  const paths = await Promise.all(
    locales.map(async (lang) => {
      const tools = await getTools(lang);
      return tools.map(({ entry, slug }) => ({
        params: { lang, slug },
        props: { entry },
      }));
    }),
  );
  return paths.flat();
}

const { entry } = Astro.props;
const locale = Astro.params.lang as Locale;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} — SoulCreator`} description={entry.data.description} locale={locale}>
  <article class="prose">
    <p class="breadcrumb"><a href={`/${locale}/tools/`}><span class="arr" aria-hidden="true">←</span> {t(locale, 'nav.tools')}</a></p>
    <h1>{entry.data.title}</h1>
    <p class="tool-meta">
      <span class="platform">{entry.data.platform}</span>
      <span aria-hidden="true">·</span>
      <a href={entry.data.github} target="_blank" rel="noopener">GitHub <span class="arr" aria-hidden="true">↗</span></a>
    </p>
    <div class="prose-md">
      <Content />
    </div>
  </article>
</Base>
