---
import Base from '../../../layouts/BaseLayout.astro';
import { t, localeParams, type Locale } from '../../../i18n';
import { getTools } from '../../../lib/content';

export async function getStaticPaths() {
  return localeParams();
}

const locale = Astro.params.lang as Locale;
const tools = await getTools(locale);
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<Base title={t(locale, 'meta.tools.title')} description={t(locale, 'meta.tools.desc')} locale={locale}>
  <article class="prose">
    <h1>{t(locale, 'nav.tools')}</h1>
    <p class="section-desc">{t(locale, 'tools.desc')}</p>
    <div class="tool-grid">
      {tools.map(({ entry, slug }, i) => (
        <article class="tool-card">
          <header class="tool-card-top">
            <span aria-hidden="true">{pad(i)}</span>
            <span>{entry.data.platform}</span>
          </header>
          <h3>
            <a href={`/${locale}/tools/${slug}/`}>{entry.data.title}</a>
          </h3>
          <p>{entry.data.description}</p>
          <a class="tool-link" href={entry.data.github} target="_blank" rel="noopener">
            GitHub <span class="arr" aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  </article>
</Base>
