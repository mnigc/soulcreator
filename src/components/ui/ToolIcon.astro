---
type Props = {
  name: 'currency' | 'media' | 'markdown' | 'clipboard' | 'star' | 'arrow' | 'download' | 'github' | 'chevron';
  size?: number;
  stroke?: number;
};

const { name = 'currency', size = 24, stroke = 2 } = Astro.props;

const icons: Record<string, string> = {
  currency: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/>',
  media: '<rect x="3" y="4" width="14" height="14" rx="2"/><path d="M17 8l4-2v10l-4-2"/><circle cx="8" cy="11" r="2"/>',
  markdown: '<path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h14"/><path d="M18 14l3 4-3 4"/>',
  clipboard: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 8h8"/><path d="M8 12h8"/><path d="M8 16h5"/><circle cx="19" cy="8" r="1"/>',
  star: '<path d="M10 2l2.5 5 5.5.8-4 3.9.9 5.5L10 15l-4.9 2.5.9-5.5-4-3.9 5.5-.8z"/>',
  arrow: '<path d="M5 10h10M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>',
  download: '<path d="M12 3l4 4-4 4M16 7H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h8" stroke-linecap="round" stroke-linejoin="round"/>',
  github: '<circle cx="10" cy="10" r="7"/><path d="M8 13h4M8 10h4M8 7h4" stroke-linecap="round"/>',
  chevron: '<path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  set:html={icons[name] || icons.currency}
></svg>