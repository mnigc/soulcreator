---
import ToolIcon from './ToolIcon.astro';
import { getIconBySlug } from './iconMap';
import type { ToolData } from '../props';
import type { Locale } from '../../i18n';

type Props = ToolData & {
  maxTags?: number;
  className?: string;
  locale?: Locale;
};

const { slug, title, titleEn, description, tags = [], platform, maxTags = 3, className = '', locale = 'zh' } = Astro.props;

const category = Astro.props.dataCategory as string | undefined;
const href = `/${locale}/tools/${slug}`;
const icon = getIconBySlug(slug);
---

<div
  class={`tool-card ${className}`.trim()}
  data-od-id={`tool-card-${slug}`}
  data-category={category || ''}
>
  <a href={href} class="tool-card-link" aria-label={title}></a>
<div class="tool-card-content">
  <div class="tool-card-head">
    <div class="tool-icon">
      <ToolIcon name={icon} size={28} />
    </div>
    <span class="tool-platform-tag">{platform}</span>
  </div>
  <div>
    <h3 class="tool-title">{title}</h3>
  </div>
  <p class="tool-desc">{description}</p>
  <div class="tool-tags">
    {tags.slice(0, maxTags).map(tag => <span class="tag">{tag}</span>)}
  </div>
</div>
</div>